# Copie este archivo a .env.local para desarrollo, o cargue estas variables en Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la comparta ni la ponga con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Facturación electrónica (Nubefact: Panel → API (Integración))
FACTURACION_PROVEEDOR=nubefact
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Protege el reenvío automático diario de comprobantes pendientes (cualquier texto largo y aleatorio)
CRON_SECRET=
