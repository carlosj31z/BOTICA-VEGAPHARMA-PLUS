# Copie este archivo a .env.local para desarrollo, o cargue estas variables en Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la comparta ni la ponga con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Facturación electrónica (Nubefact: Panel → API (Integración))
FACTURACION_PROVEEDOR=nubefact
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Protege las tareas diarias (reenvío a SUNAT y lectura de alertas DIGEMID) (cualquier texto largo y aleatorio)
CRON_SECRET=

# Opcional · Consulta de DNI (RENIEC) y RUC (SUNAT) al vender. Cree una cuenta en decolecta.com (o apis.net.pe) y pegue su token.
CONSULTA_DOC_PROVEEDOR=decolecta
CONSULTA_DOC_TOKEN=

# Opcional · Sección de alertas DIGEMID que se lee cada día (se usa su feed RSS «feed/»; solo cambiarla si DIGEMID mueve la sección)
# DIGEMID_ALERTAS_URL=https://www.digemid.minsa.gob.pe/webDigemid/publicaciones/alertas-modificaciones/
# Opcional · API pública del buscador del Observatorio de Precios (precios de mercado)
# OPM_API_URL=https://ms-opm.minsa.gob.pe/msopmcovid
